@using HotelWebsite.Models;

@{
    ViewBag.Title = "Blog Hotel Home Naran | Hotel Booking Naran Kaghan";
    ViewBag.canonical = "https://hotelhome.com.pk/blog-hotelhome-naran";
    ViewBag.keywords = "Hotel Booking Naran Naran hotel booking, hotels in Naran, hotels at Naran, Naran hotel contact number, Naran kaghan hotel booking, hotel rent in Naran kaghan, Naran hotel home, online hotel booking in Naran kaghan";

    ViewBag.Description = "Explore our blog page for the latest updated about Naran & ultimate guide for hotel booking Naran. Book Hotel Home Naran for luxury stay in Naran valley.";



    var blogs = (List<Post>)ViewBag.blogs;

}

<main>

    <div class="hero medium-height jarallax" data-jarallax data-speed="0.2">
        <img class="jarallax-img" src="../content/paradise/img/Banner.png" alt="">
        <div class="wrapper opacity-mask d-flex align-items-center justify-content-center text-center animate_hero" data-opacity-mask="rgba(0, 0, 0, 0.5)">
            <div class="container">
                <small class="slide-animated one">Hotel Home Naran Blog</small>
                <h1 class="slide-animated two">Ultimate Guide for Hotel Booking Naran</h1>
                <p class="mt-2" style="font-size:15px">
                    Welcome to Hotel Home Naran's Blog page, where we provide our guests with the latest news, trends, and helpful tips for hotel booking Naran. With our years of experience in the hospitality industry, we understand the importance of finding the right hotel for your trip to Naran. That's why we are proud to say that Hotel Home Naran is one of the best Naran hotels that you can choose for your stay. Our blog page is just one of the many resources available to you to help you make the most of your time in Naran. So read on and discover the beauty and excitement that awaits you here at Hotel Home Naran.
                </p>
            </div>
        </div>
    </div>
    <!-- /Background Img Parallax -->
    <div class="container mt-5">
       
    </div>
    <div class="container margin_120_95">
        <div class="isotope-wrapper">
            <div class="row justify-content-center">
                @{
                    foreach (var ro in blogs)
                    {
                        string detailUrl = "/post/" + ro.PostId;
                        <div class="item col-xl-4 col-lg-6">
                            <a href="@detailUrl" class="box_contents" data-cue="slideInUp">
                                <figure>  <img src="../uploads/blog/@ro.DefaultImage" alt="" class="img-fluid"><em>@ro.PublishedDate</em></figure>
                                <div class="wrapper">
                                    <small>Travel<span></span></small>
                                    <h2>@ro.Title</h2>
                                    <em>Read more</em>
                                </div>
                            </a>
                        </div>
                    }
                }

            </div>
            <!--/row -->
        </div>
        <!--/isotope-wrapper -->


    </div>
    <!--/container -->
</main>


<script>
    !(function (d, s, id) {
        var js,
            fjs = d.getElementsByTagName(s)[0];
        if (!d.getElementById(id)) {
            js = d.createElement(s);
            js.id = id;
            js.src = "https://weatherwidget.io/js/widget.min.js";
            fjs.parentNode.insertBefore(js, fjs);
        }
    })(document, "script", "weatherwidget-io-js");</script>