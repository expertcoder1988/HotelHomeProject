@{
    ViewBag.Title = "Hotel Home Naran | Best Hotel in Naran Kaghan Valley";
    ViewBag.keywords = "Hotel at Naran";
    ViewBag.canonical = "https://hotelhome.com.pk/";

    ViewBag.Description = "Naran Hotel Home is the best hotel in Naran Kaghan Valley offering the best hotel rates in Naran. Enjoy a relaxing stay at rooms with a view. Book room online.";

    List<HotelWebsite.Models.PropertySearch> results = new List<HotelWebsite.Models.PropertySearch>();


    if (TempData.ContainsKey("roomList"))
    {
        results = (List<HotelWebsite.Models.PropertySearch>)TempData["roomList"];
    }
}

<style>
    .modal-open .ui-datepicker {
        z-index: 2000 !important
    }

    .modal-button {
        float: left;
    }
</style>

<script src="https://code.jquery.com/jquery-1.10.2.js"></script>
<script type="text/javascript">
    var $j = jQuery.noConflict();
    var value = 0;

    $j(function () {
        $j("input[name='adultminus']").on('click', function (e) {
            var id = ($j(this).data("value"));
            //alert(id);
            if ($j('#adults').val() > 1) {
                value = parseInt($j('#adults').val() - 1);
                $j('#adults').val(value);
            }
        });

        $j("input[name='adultplus']").on('click', function (e) {
            var id = ($j(this).data("value"));
            if ($j('#adults').val() < 13) {
                value = parseInt($j('#adults').val()) + 1;
                $j('#adults').val(value);
            }
        });

        $j("input[name='childminus']").on('click', function (e) {
            var id = ($j(this).data("value"));
            //alert(id);
            if ($j('#childs').val() > 1) {
                value = parseInt($j('#childs').val() - 1);
                $j('#childs').val(value);
            }
        });

        $j("input[name='childplus']").on('click', function (e) {
            var id = ($j(this).data("value"));
            if ($j('#childs').val() < 5) {
                value = parseInt($j('#childs').val()) + 1;
                $j('#childs').val(value);
            }
        });
    });
</script>


<input type="hidden" id="AvoidReload" value="false" />

