@using HotelWebsite.Models;

@{
    ViewBag.Title = "Hotel Home at Naran | Available Rooms";
    ViewBag.keywords = "Hotel at Naran";

    ViewBag.Description = "Hotel Home at Naran is the best place to stay. Our hotel in Naran Pakistan offers luxurious rooms, equipped with all the amenities. Book Online.";


    List<HotelWebsite.Models.PropertySearch> results = new List<HotelWebsite.Models.PropertySearch>();

    string _CheckIn = "";// DateTime.Now;
    string _CheckOut = ""; // DateTime.Now;

    int checkRooms = 0;

    int? _adults = 0;
    int? _children = 0;
    int? _NoOfRooms = 0;
    int? roomPrice = 0;
    int? _TotalPax = 0;
    string Params = (string)Session["params"];
    string[] p = Params.Split('&');

    _CheckIn = Convert.ToString(p[0]);
    _CheckOut = Convert.ToString(p[1]);
    _adults = Convert.ToInt32(p[2]);
    _children = Convert.ToInt32(p[3]);
    _NoOfRooms = Convert.ToInt32(p[4]);
    _TotalPax = _adults + _children;

    if (_TotalPax == 0)
    {
        _TotalPax = 1;
    }

    if (Session["results"] != null)
    {
        results = (List<HotelWebsite.Models.PropertySearch>)Session["results"];
    }

}

<style>
