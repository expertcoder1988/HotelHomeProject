    <div class="container margin_120_0">
        @if (results.Count == 0)
        {
            <div class="txt7">
                <p>No room available. Please try another dates.</p>
            </div>
        }
        else
        {
            foreach (var item in results)
            {
                HotelDBEntities2 HDE = new HotelDBEntities2();

                var rp = (from a in HDE.RoomPictures
                          where (a.RoomCode == item.RoomCateCode && a.Active == true)
                          select new
                          {
                              ImageName = a.Picture
                          }).ToList();

                if (item.NoOfRooms > 0)
                {
                    string[] features = null;
                    checkRooms = 1;
                    using (Html.BeginForm("ReservationPost2", "SearchResult", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row_list_version_2">
                            <div class="row g-0 align-items-center">
                                <div class="col-xl-8">
                                    <div class="roomsleft">
                                        <span>Hurry! @item.NoOfRooms Rooms Available</span>
                                    </div>
                                    <div class="owl-carousel owl-theme carousel_item_1 kenburns rounded-img">
                                        @{

                                            foreach (var itm in rp)
                                            {
                                                <div class="item">
                                                    <a data-fslightbox="gallery_1" data-type="image" href="../uploads/@itm.ImageName"><img src="../uploads/@itm.ImageName" alt="hotel in naran"></a>
                                                </div>
                                            }
                                        }

                                    </div>
                                    <!-- /carousel -->
                                </div>
                                <div class="col-xl-4">
                                    <div class="box_item_info" data-jarallax-element="-25">


                                        <h2>@item.RoomCategory</h2>
                                        <div id="dvPolicy">
                                            Policy: <u><a role="button" name="policy" id="policy_@item.CancellationPolicy"><b>@item.Name</b></a></u>
                                        </div>
                                        <input type="hidden" data-value="@item.Id" id="hdRoomCate_@item.Id" value="@item.RoomCateCode" />
                                        <input type="hidden" name="NoOfRoomsLeft" id="NoOfRoomsLeft_@item.Id" value="@item.NoOfRooms" />
                                        <input type="hidden" id="hdNormalPrice_@item.Id" value="@item.TotalAmount" />
                                        <input type="hidden" id="hdDiscountedPrice_@item.Id" value="@item.discountedprice" />
                                        <input type="hidden" name="RatePlanID" id="RatePlanID_@item.Id" value="@item.rateplanId" />
                                        <div class="row mt-2">
                                            <div class="col-12">
                                                Add Rooms:
                                                <input type="button" ID="CalculateMinus_@item.Id" name="CalculateMinus" data-value="@item.Id" value="-" />
                                                <input type="text" value="1" style="width:30px" name="txtQuatntity" ID="txtQuatntity_@item.Id" class="text-center" />
                                                <input type="button" data-value="@item.Id" ID="CalculatePlus_@item.Id" name="CalculatePlus" value="+" />
                                                <input type="checkbox" style="display:none" name="SelectRoom" id="SelectRoom_@item.Id" value="@item.Id" />
                                            </div>

                                        </div>
                                        <input type="hidden" data-value="@item.Id" id="hdRoomCate_@item.Id" value="@item.RoomCateCode" />
                                        <input type="hidden" name="NoOfRoomsLeft" id="NoOfRoomsLeft_@item.Id" value="@item.NoOfRooms" />
                                        <div class="facilities clearfix">
                                            @if (item.Amenities != null)
                                            {
                                                <ul>
                                                    @foreach (var amenity in item.Amenities)
                                                    {
                                                        <li>
                                                            <i class="@amenity.Icon"></i> @amenity.AmenityText
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                        <br />
                                        <div class="">
                                            <span><img style="width:12px;height:12px;margin-bottom:4px" src="~/Content/paradise/images(1)/user_icon.png" /> @item.AdultAllowed Adults, @item.NoOfChildAllowed Children</span>
                                        </div>
                                        <div class="box_item_footer d-flex align-items-center justify-content-between">
                                            <input type="hidden" id="hdVid_@item.Id" value="https://www.youtube.com/embed/g30e6Hi35Jg" />
                                            <input type="hidden" id="hdTotalRooms" name="hdTotalRooms" value="1" />
                                            <input type="hidden" id="hdTotalAmount" name="hdTotalAmount" value="@item.discountedprice" />
                                            <input type="hidden" name="CheckIn" value="@_CheckIn" />
                                            <input type="hidden" name="CheckOut" value="@_CheckOut" />
                                            <input type="hidden" name="RoomCatCode" id="RoomCatCode" />
                                            <input type="hidden" name="Adults" value="@_adults" />
                                            <input type="hidden" name="Children" value="@_children" />
                                            <input type="hidden" name="NoOfRooms" value="@_NoOfRooms" />
                                            <input type="hidden" name="RoomRate" value="@roomPrice" />
                                            <input type="hidden" name="RoomCate" value="@item.RoomCateCode" />
                                            <input type="hidden" name="RoomCateRoomNums" id="RoomCateRoomNums" />
                                            <input type="hidden" name="RatePlanIDs" value="@item.rateplanId" />
                                            <input type="hidden" name="RoomRates" value="@item.discountedprice" />

                                            <button type="submit" style="border:none" class="btn_4 learn-more bg-transparent">
                                                <span class="circle">
                                                    <span class="icon arrow"></span>
                                                </span>
                                                <span class="button-text">Book Now</span>
                                            </button>
                                            <div class="">
                                                <small style="font-size:14px;color:tan">
                                                    Rs.<span id="spNormalPrice_@item.Id" style="text-decoration:line-through">@item.TotalAmount</span><span class="DisplayMobileNone">/Night</span>
                                                    <span style="font-size:9px;color:black"> </span>
                                                </small>
                                                <small style="font-size: 16px;">
                                                    Rs.<span id="spDiscountedPRice_@item.Id">@item.discountedprice</span><span class="DisplayMobileNone">/Night</span><span style="font-size:9px;color:black"> </span>
                                                </small>
                                            </div>
                                        </div>
                                        <!-- /box_item_footer -->
                                    </div>
                                    <!-- /box_item_info -->
                                </div>
                                <!-- /col -->
                            </div>
                            <!-- /row -->
                        </div>
                        <!-- /row_list -->

                    }
                }
            }
        }
    </div>
