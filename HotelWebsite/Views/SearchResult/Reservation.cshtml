    ViewBag.keywords = "Hotel at Naran";

    ViewBag.Description = "The Hotel Home at Naran is the best place to stay. Our hotel in Naran Pakistan offers luxurious rooms, equipped with all the amenities. Book Online.";

    Layout = "~/Views/Shared/_Layout.cshtml";

